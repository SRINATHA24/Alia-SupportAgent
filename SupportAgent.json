            "sampleData": {},
            "sourceCode": {
              "code": "export const code = async (inputs) => {\n  const question = (inputs.question || '').toLowerCase();\n\n  const categoryKeywords = {\n    Account: ['password','login','account','username','profile','2fa','two-factor','session','delete account'],\n    Billing: ['refund','subscription','billing','payment','invoice','charge','discount','trial','cancel','price'],\n    Shipping: ['ship','shipping','delivery','order','package','tracking','international'],\n    Technical: ['crash','bug','error','load','app','browser','offline','cache','export','slow'],\n    Security: ['security','encrypt','gdpr','vulnerability','breach','sso','privacy'],\n    Integrations: ['integrat','slack','zapier','api','webhook','salesforce','teams','sheets'],\n    Plans: ['plan','pricing','storage','seat','upgrade','downgrade','enterprise'],\n    General: ['support hours','contact','status page','terms','feature request','forum','changelog']\n  };\n\n  let bestCategory = null;\n  let bestScore = 0;\n  for (const [category, keywords] of Object.entries(categoryKeywords)) {\n    const score = keywords.filter(k => question.includes(k)).length;\n    if (score > bestScore) {\n      bestScore = score;\n      bestCategory = category;\n    }\n  }\n\n  const filterJson = bestCategory\n    ? JSON.stringify({ property: \"Category\", select: { equals: bestCategory } })\n    : JSON.stringify({ property: \"Category\", select: { is_not_empty: true } });\n\n  return { category: bestCategory || 'All', filterJson };\n};",
              "packageJson": "{}"
            },
