                "sampleData": {},
                "sourceCode": {
                  "code": "export const code = async (inputs) => {\n  const results = inputs.KbResults || [];\n  \n  const combined = results.map(page => {\n    const props = page.properties || {};\n    \n    const name = (props.Name?.title || [])\n      .map(t => t.plain_text).join('');\n    \n    const content = (props.Content?.rich_text || [])\n      .map(t => t.plain_text).join('');\n    \n    return `Q: ${name}\\nA: ${content}`;\n  }).join('\\n\\n---\\n\\n');\n  \n  return { knowledgeBaseText: combined };\n};",
                  "packageJson": "{}"
