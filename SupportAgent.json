                    "sampleData": {},
                    "sourceCode": {
                      "code": "export const code = async (inputs) => {\n  let raw = inputs.aiResult.trim();\n  \n  // Strip markdown code fences if present\n  raw = raw.replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/```\\s*$/i, '');\n  \n  // Extract just the JSON object, ignoring any trailing/leading text\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  if (match) {\n    raw = match[0];\n  }\n  \n  try {\n    const parsed = JSON.parse(raw);\n    return parsed;\n  } catch (e) {\n    return {\n      answer: \"I'm having trouble processing this — escalating to a specialist.\",\n      confidence: 0,\n      sentiment: \"neutral\",\n      escalate: true,\n      reason: \"Failed to parse AI response: \" + e.message\n    };\n  }\n};",
